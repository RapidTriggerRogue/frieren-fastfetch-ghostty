# ==============================================================================
# Ghostty Configuration — Modern Setup (KDE Wayland / Catppuccin Frappe)
# ==============================================================================

# --- Theme & Colors ---
theme = Catppuccin Frappe
alpha-blending = linear-corrected
minimum-contrast = 1.1
window-colorspace = srgb

# --- Transparency & Blur (KDE KWin Wayland ext-background-effect-v1) ---
background-opacity = 0.86
background-opacity-cells = false
background-blur = true
unfocused-split-opacity = 0.78

# --- Typography & Nerd Font ---
font-family = FiraCode Nerd Font
font-size = 12
font-shaping-break = cursor
grapheme-width-method = unicode
# Calt & ligatures active for clean arrows/operators
font-feature = calt, liga

# --- Window Geometry & Layout (Optimized for Fastfetch + Frieren Logo) ---
window-width = 136
window-height = 38
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-padding-color = background
window-vsync = true
window-save-state = default

# --- GTK4 / Adwaita & Tab Bar Polish ---
window-theme = auto
window-decoration = auto
window-show-tab-bar = auto
gtk-titlebar = true
gtk-tabs-location = top
gtk-wide-tabs = true
gtk-titlebar-hide-when-maximized = false

# --- Cursor & Mouse ---
cursor-style = bar
cursor-style-blink = true
cursor-click-to-move = true
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:1,discrete:3
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# --- Shell Integration & Terminal Capabilities ---
# Wichtig: xterm-ghostty statt xterm-256color, damit Fastfetch (Kitty Graphics
# Protocol), Yazi und Neovim volle Grafik- und TrueColor-Features erkennen!
term = xterm-ghostty
shell-integration = zsh
shell-integration-features = cursor,sudo,title,ssh-env,ssh-terminfo,path

# --- Scrollback, Links & Notifications ---
scrollback-limit-bytes = 50000000
link-url = true
link-osc8 = true
link-previews = true
progress-style = true
desktop-notifications = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 10s
confirm-close-surface = false

# --- Quick Terminal (Drop-Down via Wayland Layer-Shell) ---
quick-terminal-position = top
quick-terminal-screen = main
quick-terminal-animation-duration = 0.15
quick-terminal-autohide = true
quick-terminal-keyboard-interactivity = on-demand

# --- Useful Keybindings ---
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+shift+o=toggle_background_opacity
